{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/exercicio1/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/exercicio1/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/exercicio1",
  "projects": {
    "exercicio1": {
      "type": "application",
      "root": "apps/exercicio1",
      "entryFile": "main",
      "sourceRoot": "apps/exercicio1/src",
      "compilerOptions": {
        "tsConfigPath": "apps/exercicio1/tsconfig.app.json"
      }
    },
    "tasks": {
      "type": "application",
      "root": "apps/tasks",
      "entryFile": "main",
      "sourceRoot": "apps/tasks/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tasks/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src"
    }
  }
}